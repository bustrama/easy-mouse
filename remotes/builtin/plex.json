{
  "$schema": "../remote.schema.json",
  "schema": 1,
  "id": "plex",
  "name": "Plex",
  "description": "Keys are the defaults of Plex Media Player (plexinc/plex-media-player, resources/inputmaps/keyboard.json): PageUp/PageDown seek, X stop, F11 fullscreen, S subtitles on/off, A next audio track. That repository is archived, so UNVERIFIED for current Plex HTPC and the Plex desktop app, and the keys go to whichever window has focus. SMTC buttons: UNVERIFIED that Plex registers with SMTC. Plex's local HTTP Player API is not used: its port is not documented, current Plex apps may no longer expose it, and every call needs an incrementing commandID, which a fixed http action cannot send.",
  "layout": {
    "cols": 3,
    "items": [
      { "type": "button", "icon": "prev", "label": "Previous", "action": { "do": "smtc", "cmd": "prev" } },
      { "type": "button", "icon": "play", "label": "Play / Pause", "action": { "do": "smtc", "cmd": "toggle" } },
      { "type": "button", "icon": "next", "label": "Next", "action": { "do": "smtc", "cmd": "next" } },
      { "type": "button", "icon": "rewind", "label": "Seek back", "action": { "do": "key", "keys": "PageUp" } },
      { "type": "button", "icon": "power", "label": "Stop", "action": { "do": "key", "keys": "X" } },
      { "type": "button", "icon": "forward", "label": "Seek forward", "action": { "do": "key", "keys": "PageDown" } },
      { "type": "button", "icon": "fullscreen", "label": "Fullscreen", "action": { "do": "key", "keys": "F11" } },
      { "type": "button", "icon": "subtitles", "label": "Subtitles", "action": { "do": "key", "keys": "S" } },
      { "type": "button", "label": "Audio track", "action": { "do": "key", "keys": "A" } },
      { "type": "button", "icon": "minus", "label": "Volume -", "action": { "do": "media", "cmd": "volDown" } },
      { "type": "button", "icon": "mute", "label": "Mute", "action": { "do": "media", "cmd": "mute" } },
      { "type": "button", "icon": "plus", "label": "Volume +", "action": { "do": "media", "cmd": "volUp" } },
      { "type": "label", "bind": "smtc.title" },
      { "type": "slider", "label": "PC volume", "bind": "volume", "action": { "do": "volume", "scope": "master" } }
    ]
  }
}
