<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray NotifyIcon -->
    <RootNamespace>EasyMouse.App</RootNamespace>
    <AssemblyName>EasyMouse</AssemblyName>
    <ApplicationIcon>../../assets/icon/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;he</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- No DOTNET_STARTUP_HOOKS: with admin control on, code another process of the user could load into this one would be able to use the broker (docs/security.md). -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, Button, ...): keep WPF as the default. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\EasyMouse.Core.csproj" />
    <ProjectReference Include="..\Server\EasyMouse.Server.csproj" />
    <ProjectReference Include="..\Platform.Windows\EasyMouse.Platform.Windows.csproj" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="[3.2.1]" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" /> <!-- Ed25519 verification of release signatures; .NET has no built-in Ed25519 -->
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <!-- The built-in remotes live next to the exe as files: the catalog hashes and re-reads them on every invocation. -->
    <Content Include="..\..\remotes\builtin\*.json" Link="remotes\builtin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EasyMouse.App.Tests" />
  </ItemGroup>
</Project>
