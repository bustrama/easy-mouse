<views:AppWindow x:Class="EasyMouse.App.Views.RemotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EasyMouse.App"
        xmlns:vm="clr-namespace:EasyMouse.App.ViewModels"
        xmlns:logic="clr-namespace:EasyMouse.App.Logic"
        xmlns:views="clr-namespace:EasyMouse.App.Views"
        Title="{app:T Rm_Title}" Width="760" Height="680" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterScreen">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{app:T Rm_Title}" FontSize="26" FontWeight="ExtraBold"/>
            <TextBlock Text="{app:T Rm_Intro}" Margin="0,6,0,0" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource SmallPrimaryButton}" Content="{app:T Rm_Import}" Command="{Binding ImportCommand}"/>
                <Button Style="{StaticResource SmallButton}" Margin="10,0,0,0" Content="{app:T Rm_OpenFolder}" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" Visibility="{Binding HasNotice, Converter={StaticResource B2V}}">
                <StackPanel>
                    <TextBlock Text="{Binding Notice}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding NoticeDetails}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}"
                                           FlowDirection="LeftToRight" FontFamily="Consolas"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" Visibility="{Binding HasLayoutWarning, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding LayoutWarning}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Warn}"/>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" Visibility="{Binding HasStoreWarning, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding StoreWarning}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Danger}"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="{app:T Rm_Empty}" Foreground="{StaticResource Muted}" FontSize="14" Margin="4,8"
                           Visibility="{Binding NoRows, Converter={StaticResource B2V}}"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RemoteRowViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding SourceText}" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Background="{Binding ChipBackground}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="Bold" Foreground="{Binding ChipForeground}" TextWrapping="NoWrap"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Margin="0,8,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                               Visibility="{Binding HasDescription, Converter={StaticResource B2V}}"/>

                                    <!-- Needs your approval: every sensitive or dangerous action, in plain words -->
                                    <StackPanel Visibility="{Binding IsNeedsReview, Converter={StaticResource B2V}}" Margin="0,14,0,0">
                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type logic:ReviewLine}">
                                                    <Border Background="{StaticResource Ink}" CornerRadius="12" Padding="14,10" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="20">
                                                                <Run Text="{Binding Where, Mode=OneWay}" FontWeight="Bold"/><Run Text=" "/><Run Text="{Binding What, Mode=OneWay}" Foreground="{StaticResource TextSoft}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{app:T Rm_Dangerous}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource Warn}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Dangerous}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding HostsText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                                                   Visibility="{Binding HasHosts, Converter={StaticResource B2V}}"/>
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SlotChoiceViewModel}">
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding PathText}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Margin="12,0,0,0" Content="{app:T Rm_Choose}" Command="{Binding ChooseCommand}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding HashText}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource SmallPrimaryButton}" MinWidth="110" Content="{app:T Rm_Approve}" Command="{Binding ApproveCommand}"/>
                                            <Button Style="{StaticResource SmallButton}" MinWidth="110" Margin="10,0,0,0" Content="{app:T Rm_Reject}" Command="{Binding RejectCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Rejected -->
                                    <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="{app:T Rm_ReviewAgain}"
                                            Command="{Binding ReviewAgainCommand}" Visibility="{Binding IsRejected, Converter={StaticResource B2V}}"/>

                                    <!-- On, and approved by the user -->
                                    <StackPanel Visibility="{Binding IsApproved, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                                        <TextBlock Text="{Binding ApprovedText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                        <Button Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{app:T Rm_Revoke}" Command="{Binding RevokeCommand}"/>
                                    </StackPanel>

                                    <!-- Invalid -->
                                    <StackPanel Visibility="{Binding IsInvalid, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                                        <TextBlock Text="{app:T Rm_Errors}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Danger}"/>
                                        <ItemsControl ItemsSource="{Binding Errors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="Consolas" FlowDirection="LeftToRight"
                                                               Foreground="{StaticResource TextSoft}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:AppWindow>
