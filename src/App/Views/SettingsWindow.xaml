<views:AppWindow x:Class="EasyMouse.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EasyMouse.App"
        xmlns:vm="clr-namespace:EasyMouse.App.ViewModels"
        xmlns:views="clr-namespace:EasyMouse.App.Views"
        Title="{Binding WindowTitle}" Width="860" Height="640" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <views:AppWindow.Resources>
        <!-- One settings row: Header = title, Tag = description, Content = the control on the end. -->
        <Style x:Key="Row" TargetType="HeaderedContentControl">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="{TemplateBinding Tag}" Margin="0,2,0,0" FontSize="13" LineHeight="19" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <ContentPresenter Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="10" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageHost" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </views:AppWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ItemsControl ItemsSource="{Binding Nav}" Margin="12,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NavItem}">
                    <Button Style="{StaticResource NavButton}" Margin="0,0,0,2"
                            Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Page}">
                        <TextBlock Text="{Binding Label}" TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,8,32,24">
            <Grid>
                <!-- General -->
                <StackPanel Visibility="{Binding IsGeneral, Converter={StaticResource B2V}}">
                    <TextBlock Style="{StaticResource Group}" Text="{app:T Grp_Startup}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,0,0,-1">
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_StartWindows}" Tag="{app:T Set_StartWindowsDesc}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_StartMin}" Tag="{app:T Set_StartMinDesc}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimised, Mode=TwoWay}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Group}" Text="{app:T Grp_Language}" Margin="0,22,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <HeaderedContentControl Margin="0,0,0,-1" Style="{StaticResource Row}" Header="{app:T Set_Language}" Tag="{app:T Set_LanguageDesc}">
                            <ComboBox x:Name="LanguageBox" Style="{StaticResource ValueCombo}" MinWidth="190" ItemsSource="{Binding Languages}" SelectedValuePath="Code" SelectedValue="{Binding LanguageCode, Mode=OneWay}"
                                      SelectionChanged="OnLanguageChosen"/>
                        </HeaderedContentControl>
                    </Border>
                </StackPanel>

                <!-- Network -->
                <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource B2V}}">
                    <TextBlock Style="{StaticResource Group}" Text="{app:T Grp_Network}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,0,0,-1">
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_Port}" Tag="{app:T Set_PortDesc}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource ValueBox}" Width="110" MaxLength="5" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="OK" Command="{Binding ApplyPortCommand}" MinWidth="48"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <TextBlock Text="{Binding PortError}" Foreground="{StaticResource Warn}" FontSize="13" Margin="18,0,18,10"
                                       Visibility="{Binding HasPortError, Converter={StaticResource B2V}}"/>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_Card}" Tag="{app:T Set_CardDesc}">
                                <ComboBox x:Name="CardBox" Style="{StaticResource ValueCombo}" MinWidth="230" ItemsSource="{Binding Adapters}" SelectedValuePath="Id" SelectedValue="{Binding SelectedAdapterId, Mode=OneWay}"
                                          SelectionChanged="OnCardChosen"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_Status}" Tag="{Binding StatusText}">
                                <Ellipse Width="10" Height="10">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsProblem}" Value="True"><Setter Property="Fill" Value="{StaticResource Warn}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Security -->
                <StackPanel Visibility="{Binding IsSecurity, Converter={StaticResource B2V}}">
                    <TextBlock Style="{StaticResource Group}" Text="{app:T Grp_Security}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,0,0,-1">
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_Admin}" Tag="{app:T Set_AdminDesc}">
                                <CheckBox x:Name="AdminToggle" Style="{StaticResource ToggleSwitch}" IsEnabled="{Binding AdminAvailable}" IsChecked="{Binding AdminChecked, Mode=OneWay}" Click="OnAdminToggled"/>
                            </HeaderedContentControl>
                            <TextBlock Text="{Binding AdminStatusText}" TextWrapping="Wrap" FontSize="13" Margin="18,0,18,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdminStatusIsProblem}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AdminMessage}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13" Margin="18,0,18,12"
                                       Visibility="{Binding HasAdminMessage, Converter={StaticResource B2V}}"/>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Set_Hotkey}" Tag="{app:T Set_HotkeyDesc}">
                                <TextBox x:Name="HotkeyBox" Style="{StaticResource ValueBox}" MinWidth="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         Text="{Binding HotkeyText, Mode=OneWay}" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                                         PreviewKeyDown="OnHotkeyKeyDown"/>
                            </HeaderedContentControl>
                            <TextBlock Text="{Binding HotkeyMessage}" Foreground="{StaticResource Warn}" FontSize="13" Margin="18,0,18,10"
                                       Visibility="{Binding HasHotkeyMessage, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Devices -->
                <StackPanel Visibility="{Binding IsDevices, Converter={StaticResource B2V}}">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Group}" Text="{app:T Dev_Paired}" Margin="0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Right" Content="{app:T Dev_DisconnectAll}" Command="{Binding DisconnectAllCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <Grid Margin="0,0,0,-1">
                            <TextBlock Text="{app:T Dev_Empty}" Foreground="{StaticResource Muted}" FontSize="14" Margin="18,18"
                                       Visibility="{Binding NoDevices, Converter={StaticResource B2V}}"/>
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceRowViewModel}">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Ink}">
                                                    <Path Data="M9.5,2.5 H14.5 A2.5,2.5 0 0 1 17,5 V19 A2.5,2.5 0 0 1 14.5,21.5 H9.5 A2.5,2.5 0 0 1 7,19 V5 A2.5,2.5 0 0 1 9.5,2.5 Z M11,18.5 H13"
                                                          Stroke="{StaticResource TextSoft}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Stretch="Uniform" Width="22" Height="22" FlowDirection="LeftToRight"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding Meta}" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Muted}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="6" Padding="10,4" Background="{Binding Background}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" Foreground="{Binding Foreground}" TextWrapping="NoWrap"/>
                                                </Border>
                                                <Button Grid.Column="3" Style="{StaticResource SmallButton}" Margin="14,0,0,0" Content="{app:T Dev_Remove}"
                                                        Command="{Binding RemoveCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Updates -->
                <StackPanel Visibility="{Binding IsUpdates, Converter={StaticResource B2V}}">
                    <TextBlock Style="{StaticResource Group}" Text="{app:T Upd_Group}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,0,0,-1">
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Upd_Check}" Tag="{app:T Upd_CheckDesc}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.CheckEnabled, Mode=TwoWay}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Upd_Pre}" Tag="{app:T Upd_PreDesc}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.IncludePrereleases, Mode=TwoWay}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Upd_Current}" Tag="{Binding Updates.CurrentVersionText}">
                                <Button Style="{StaticResource SmallButton}" Content="{app:T Upd_CheckNow}" Command="{Binding Updates.CheckNowCommand}" MinWidth="110"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="{app:T Upd_LastChecked}" Tag="{Binding Updates.LastCheckedText}">
                                <Grid/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Padding="16,12" Margin="0,14,0,0" Visibility="{Binding Updates.HasStatus, Converter={StaticResource B2V}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource ChipGreyBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Updates.StatusIsProblem}" Value="True"><Setter Property="Background" Value="{StaticResource ChipAmberBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Updates.StatusIsUpdate}" Value="True"><Setter Property="Background" Value="{StaticResource ChipBlueBg}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Updates.StatusText}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ChipGreyFg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Updates.StatusIsProblem}" Value="True"><Setter Property="Foreground" Value="{StaticResource ChipAmberFg}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Updates.StatusIsUpdate}" Value="True"><Setter Property="Foreground" Value="{StaticResource ChipBlueFg}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource SmallPrimaryButton}" Margin="16,0,0,0" Content="{Binding Updates.InstallLabel}"
                                    Command="{Binding Updates.InstallCommand}" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource B2V}}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding Updates.HasNotes, Converter={StaticResource B2V}}">
                        <StackPanel Margin="18,14">
                            <TextBlock Text="{Binding Updates.NotesTitle}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Updates.Notes}" Margin="0,8,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{app:T Upd_Disclosure}" Margin="2,16,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <!-- About -->
                <StackPanel Visibility="{Binding IsAbout, Converter={StaticResource B2V}}">
                    <TextBlock Text="{app:T App_Name}" FontSize="26" FontWeight="ExtraBold"/>
                    <TextBlock Text="{Binding VersionLine}" Margin="0,6,0,0" FontSize="15" Foreground="{StaticResource TextSoft}"/>
                    <TextBlock Text="{app:T About_Line2}" Margin="0,16,0,0" FontSize="15" Foreground="{StaticResource TextSoft}"/>
                    <TextBlock Text="{app:T About_Line3}" Margin="0,6,0,0" FontSize="15" Foreground="{StaticResource TextSoft}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</views:AppWindow>
