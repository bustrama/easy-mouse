<Project Sdk="Microsoft.NET.Sdk">
  <!-- Manual check of the SYSTEM broker on a real machine (see README.md here). Not run by CI: it needs the service installed and an interactive desktop. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>EasyMouse.Broker.SmokeTest</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform.Windows\EasyMouse.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
